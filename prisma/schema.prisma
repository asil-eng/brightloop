// Brightloop — Subscription Management System
// All money values are stored as integers in minor units (paise/cents) to avoid rounding errors.
// PostgreSQL in every environment (local Docker, Neon in production).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection used by the app
  directUrl = env("DIRECT_URL") // direct connection used for migrations
}

// ───────────── Users & auth ─────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  orgId        String       @default("") // set by scopedDb()
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  role         Role         @default(CUSTOMER)
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now())

  customer      Customer?
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  subscriptions Subscription[]       @relation("Salesperson")
  payments      Payment[]
  activities    Activity[]

  @@index([orgId])
}

model Session {
  id        String   @id // sha256 of the cookie token
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  purpose   String    @default("reset") // reset | invite
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ───────────── Companies (tenants) ─────────────

// Every business that registers gets its own organization. All of its data carries
// orgId, and the app reads and writes through a client scoped to one organization.
model Organization {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  email               String   @default("")
  phone               String   @default("")
  address             String   @default("")
  currency            String   @default("INR")
  autoConfirmInvoices Boolean  @default(true)
  autoSendInvoices    Boolean  @default(true)
  overdueReminderDays Int      @default(3)
  renewalReminderDays Int      @default(7)
  createdAt           DateTime @default(now())

  // The company's own outgoing email account. Emails to its customers are sent
  // only through this account; the password is encrypted (see lib/secret-box.ts).
  smtpHost         String    @default("")
  smtpPort         Int       @default(465)
  smtpUser         String    @default("")
  smtpPassword     String    @default("")
  smtpFrom         String    @default("")
  emailConnectedAt DateTime?

  // The company's own Razorpay account (test mode). Customers' online payments go to it;
  // the key secret is encrypted like the email password.
  razorpayKeyId       String    @default("")
  razorpayKeySecret   String    @default("")
  razorpayConnectedAt DateTime?

  users         User[]
  customers     Customer[]
  taxes         Tax[]
  products      Product[]
  attributes    Attribute[]
  variants      ProductVariant[]
  plans         RecurringPlan[]
  paymentTerms  PaymentTerm[]
  templates     QuotationTemplate[]
  closeReasons  CloseReason[]
  subscriptions Subscription[]
  discounts     Discount[]
  invoices      Invoice[]
  payments      Payment[]
  activities    Activity[]
  emails        EmailLog[]
  sequences     Sequence[]
}

model Sequence {
  id    String       @id @default(cuid())
  orgId String       @default("") // set by scopedDb()
  name  String // subscription | invoice | payment
  next  Int          @default(1)
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
}

// ───────────── Customers ─────────────

model Customer {
  orgId     String       @default("") // set by scopedDb()
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id        String       @id @default(cuid())
  name      String
  email     String
  phone     String       @default("")
  company   String       @default("")
  address   String       @default("")
  taxId     String       @default("")
  userId    String?      @unique
  createdAt DateTime     @default(now())

  user          User?          @relation(fields: [userId], references: [id])
  subscriptions Subscription[]
  invoices      Invoice[]

  @@index([email])
  @@index([name])
  @@index([orgId])
}

// ───────────── Catalogue ─────────────

enum ProductType {
  SERVICE
  ADDON
  GOODS
}

model Tax {
  orgId         String       @default("") // set by scopedDb()
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id            String       @id @default(cuid())
  name          String
  rate          Float // percentage, e.g. 18 = 18%
  priceIncluded Boolean      @default(false)
  active        Boolean      @default(true)

  products          Product[]
  subscriptionLines SubscriptionLine[]

  @@index([orgId])
}

model Product {
  orgId      String       @default("") // set by scopedDb()
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id         String       @id @default(cuid())
  name       String
  type       ProductType  @default(SERVICE)
  salesPrice Int
  costPrice  Int          @default(0)
  notes      String       @default("")
  recurring  Boolean      @default(true)
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())

  taxes             Tax[]
  variants          ProductVariant[]
  attributes        Attribute[]
  templateLines     TemplateLine[]
  subscriptionLines SubscriptionLine[]
  discounts         Discount[]

  @@index([orgId])
}

model Attribute {
  orgId     String           @default("") // set by scopedDb()
  org       Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id        String           @id @default(cuid())
  name      String
  productId String
  product   Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  values    AttributeValue[]

  @@index([orgId])
}

model AttributeValue {
  id          String           @id @default(cuid())
  name        String
  extraPrice  Int              @default(0)
  attributeId String
  attribute   Attribute        @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
}

model ProductVariant {
  orgId      String           @default("") // set by scopedDb()
  org        Organization     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id         String           @id @default(cuid())
  productId  String
  name       String // e.g. "Brand: Odoo"
  extraPrice Int              @default(0) // sum of attribute value extras
  active     Boolean          @default(true)
  product    Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  values     AttributeValue[]

  templateLines     TemplateLine[]
  subscriptionLines SubscriptionLine[]

  @@index([orgId])
}

enum BillingPeriod {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model RecurringPlan {
  orgId       String        @default("") // set by scopedDb()
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id          String        @id @default(cuid())
  name        String
  price       Int           @default(0) // recurring plan fee, added as a line
  period      BillingPeriod @default(MONTHLY)
  interval    Int           @default(1) // bill every N periods
  minQuantity Int           @default(1)
  startDate   DateTime?
  endDate     DateTime?
  autoClose   Boolean       @default(false)
  closable    Boolean       @default(true)
  pausable    Boolean       @default(true)
  renewable   Boolean       @default(true)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  templates     QuotationTemplate[]
  subscriptions Subscription[]

  @@index([orgId])
}

model PaymentTerm {
  orgId   String       @default("") // set by scopedDb()
  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id      String       @id @default(cuid())
  name    String
  dueDays Int          @default(0)

  templates     QuotationTemplate[]
  subscriptions Subscription[]

  @@index([orgId])
}

model QuotationTemplate {
  orgId         String         @default("") // set by scopedDb()
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id            String         @id @default(cuid())
  name          String
  planId        String
  validityDays  Int            @default(30)
  paymentTermId String?
  note          String         @default("")
  plan          RecurringPlan  @relation(fields: [planId], references: [id])
  paymentTerm   PaymentTerm?   @relation(fields: [paymentTermId], references: [id])
  lines         TemplateLine[]
  subscriptions Subscription[]

  @@index([orgId])
}

model TemplateLine {
  id         String            @id @default(cuid())
  templateId String
  productId  String
  variantId  String?
  quantity   Int               @default(1)
  template   QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  product    Product           @relation(fields: [productId], references: [id])
  variant    ProductVariant?   @relation(fields: [variantId], references: [id])
}

// ───────────── Subscriptions ─────────────

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

model CloseReason {
  orgId         String         @default("") // set by scopedDb()
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id            String         @id @default(cuid())
  name          String
  subscriptions Subscription[]

  @@index([orgId])
}

model Subscription {
  orgId             String             @default("") // set by scopedDb()
  org               Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id                String             @id @default(cuid())
  number            String
  customerId        String
  planId            String
  status            SubscriptionStatus @default(DRAFT)
  startDate         DateTime
  expiryDate        DateTime?
  nextInvoiceDate   DateTime?
  quoteValidUntil   DateTime?
  paymentTermId     String?
  salespersonId     String?
  templateId        String?
  closeReasonId     String?
  closedAt          DateTime?
  renewalReminderAt DateTime?
  note              String             @default("")
  untaxed           Int                @default(0)
  taxTotal          Int                @default(0)
  total             Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  customer    Customer           @relation(fields: [customerId], references: [id])
  plan        RecurringPlan      @relation(fields: [planId], references: [id])
  paymentTerm PaymentTerm?       @relation(fields: [paymentTermId], references: [id])
  salesperson User?              @relation("Salesperson", fields: [salespersonId], references: [id])
  template    QuotationTemplate? @relation(fields: [templateId], references: [id])
  closeReason CloseReason?       @relation(fields: [closeReasonId], references: [id])
  lines       SubscriptionLine[]
  invoices    Invoice[]
  discounts   Discount[]

  @@unique([orgId, number])
  @@index([status])
  @@index([customerId])
  @@index([status, nextInvoiceDate])
  @@index([createdAt])
  @@index([orgId])
}

model SubscriptionLine {
  id             String          @id @default(cuid())
  subscriptionId String
  productId      String?
  variantId      String?
  description    String
  quantity       Int             @default(1)
  unitPrice      Int
  subtotal       Int             @default(0)
  taxAmount      Int             @default(0)
  total          Int             @default(0)
  subscription   Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  product        Product?        @relation(fields: [productId], references: [id])
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  taxes          Tax[]

  @@index([subscriptionId])
}

// ───────────── Discounts ─────────────

enum DiscountType {
  FIXED
  PERCENT
}

enum DiscountScope {
  PRODUCTS // applies to lines of the selected products, on any subscription
  SUBSCRIPTION // applies to the whole total of the selected subscriptions
}

model Discount {
  orgId       String        @default("") // set by scopedDb()
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id          String        @id @default(cuid())
  name        String
  type        DiscountType  @default(PERCENT)
  value       Float // percent (e.g. 10) or fixed amount in minor units
  scope       DiscountScope @default(PRODUCTS)
  minPurchase Int? // minor units
  minQuantity Int?
  startDate   DateTime?
  endDate     DateTime?
  usageLimit  Int?
  usedCount   Int           @default(0)
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now())

  products      Product[]
  subscriptions Subscription[]
  invoiceLines  InvoiceLine[]

  @@index([orgId])
}

// ───────────── Invoices & payments ─────────────

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  CANCELLED
}

model Invoice {
  orgId          String        @default("") // set by scopedDb()
  org            Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id             String        @id @default(cuid())
  number         String? // assigned on confirmation
  // "<subscriptionId>:<periodStart ISO>" — unique while the invoice is not cancelled,
  // which guarantees a billing period is never invoiced twice.
  billingKey     String?       @unique
  subscriptionId String?
  customerId     String
  status         InvoiceStatus @default(DRAFT)
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime
  periodStart    DateTime?
  periodEnd      DateTime?
  untaxed        Int           @default(0)
  discountTotal  Int           @default(0)
  taxTotal       Int           @default(0)
  total          Int           @default(0)
  amountPaid     Int           @default(0)
  sentAt         DateTime?
  reminderSentAt DateTime?
  createdAt      DateTime      @default(now())

  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])
  lines        InvoiceLine[]
  payments     Payment[]

  @@unique([orgId, number])
  @@index([status, dueDate])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([invoiceDate])
  @@index([orgId])
}

model InvoiceLine {
  id             String    @id @default(cuid())
  invoiceId      String
  productId      String?
  description    String
  quantity       Int       @default(1)
  unitPrice      Int
  discountAmount Int       @default(0)
  subtotal       Int // after discount, before tax
  taxAmount      Int       @default(0)
  total          Int
  taxLabel       String    @default("")
  discountId     String?
  invoice        Invoice   @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  discount       Discount? @relation(fields: [discountId], references: [id])

  @@index([invoiceId])
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD
  UPI
  CHEQUE
  ONLINE
}

model Payment {
  orgId            String        @default("") // set by scopedDb()
  org              Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id               String        @id @default(cuid())
  number           String
  invoiceId        String
  amount           Int
  method           PaymentMethod
  date             DateTime      @default(now())
  note             String        @default("")
  reference        String        @default("")
  // Razorpay payment id for online payments: unique, so the same payment can never be recorded twice.
  gatewayPaymentId String?       @unique
  createdById      String?
  createdAt        DateTime      @default(now())
  invoice          Invoice       @relation(fields: [invoiceId], references: [id])
  createdBy        User?         @relation(fields: [createdById], references: [id])

  @@unique([orgId, number])
  @@index([invoiceId])
  @@index([date])
  @@index([orgId])
}

// ───────────── Chatter & email log ─────────────

model Activity {
  orgId      String       @default("") // set by scopedDb()
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id         String       @id @default(cuid())
  entityType String // subscription | invoice | customer
  entityId   String
  message    String
  isNote     Boolean      @default(false)
  userId     String?
  createdAt  DateTime     @default(now())
  user       User?        @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([orgId])
}

model EmailLog {
  orgId      String       @default("") // set by scopedDb()
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  id         String       @id @default(cuid())
  to         String
  subject    String
  status     String // sent | failed | not_sent (company email not connected / limit) | logged (dev console)
  kind       String       @default("company") // company: to the company's customers; account: password resets, welcomes, invites
  error      String       @default("")
  entityType String?
  entityId   String?
  createdAt  DateTime     @default(now())

  @@index([createdAt])
  @@index([orgId])
}

// Recent sensitive attempts (failed logins, reset requests), used for rate limiting.
model RateLimitHit {
  id        String   @id @default(cuid())
  key       String // e.g. "login:ana@example.com"
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}
