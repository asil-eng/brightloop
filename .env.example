# Database: PostgreSQL.
# Local:      docker run -d --name brightloop-pg -e POSTGRES_USER=brightloop -e POSTGRES_PASSWORD=brightloop \
#               -e POSTGRES_DB=brightloop -p 5433:5432 postgres:16-alpine
# Production: Neon. DATABASE_URL = the pooled connection string, DIRECT_URL = the direct one.
DATABASE_URL="postgresql://brightloop:brightloop@localhost:5433/brightloop"
DIRECT_URL="postgresql://brightloop:brightloop@localhost:5433/brightloop"

# Public URL used in email links
APP_URL="http://localhost:3000"

# Platform email: ONLY for account emails (password resets, new-company welcome, staff invites).
# Emails to a company's customers are sent through the company's own account, connected in
# Settings -> Email. Leave SMTP_HOST empty in development to print emails to the console.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<app password, no spaces>
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_ADDRESS=""
# Daily cap on platform (account) emails, to protect the sender account.
PLATFORM_EMAIL_DAILY_LIMIT="200"

# Encrypts companies' email passwords. Any long random string; keep it secret and never change it
# once companies have connected email (generate with: openssl rand -base64 32).
EMAIL_ENCRYPTION_KEY="dev-only-change-me"

# Secret used to protect the cron endpoint
CRON_SECRET="change-me"
