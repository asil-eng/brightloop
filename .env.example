# Database: PostgreSQL.
# Local:      docker run -d --name brightloop-pg -e POSTGRES_USER=brightloop -e POSTGRES_PASSWORD=brightloop \
#               -e POSTGRES_DB=brightloop -p 5433:5432 postgres:16-alpine
# Production: Neon. DATABASE_URL = the pooled connection string, DIRECT_URL = the direct one.
DATABASE_URL="postgresql://brightloop:brightloop@localhost:5433/brightloop"
DIRECT_URL="postgresql://brightloop:brightloop@localhost:5433/brightloop"

# Public URL used in email links
APP_URL="http://localhost:3000"

# Email (SMTP). Leave SMTP_HOST empty to log emails to the console instead of sending.
# Mailpit (local): SMTP_HOST=localhost SMTP_PORT=1025
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<app password>
SMTP_HOST=""
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASS=""
# Sender address. Emails show the sending company's name, with replies going to its billing email.
MAIL_FROM_ADDRESS="billing@brightloop.test"

# Secret used to protect the cron endpoint
CRON_SECRET="change-me"
